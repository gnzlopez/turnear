@page "{id:int}"
@model AppointmentManager.Pages.Admin.AppointmentStatuses.EditModel

<h1>Edit Appointment Status</h1>

<form method="post">
    <input type="hidden" asp-for="Status.Id" />

    <div class="mb-3">
        <label asp-for="Status.Name" class="form-label"></label>
        <input asp-for="Status.Name" class="form-control" />
        <span asp-validation-for="Status.Name" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="Status.SendMail" class="form-check-input" />
        <label asp-for="Status.SendMail" class="form-check-label">Envia Mail</label>
    </div>

    <div class="mb-3 d-flex gap-2">
        <!-- Botón para abrir modal que editará la plantilla del estado ya cargado -->
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#templateModal">
            Plantilla de Mail
        </button>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="Index" class="btn btn-secondary">Back to list</a>
    </div>

    <!-- Modal (dentro del form para que el textarea sea parte del post) -->
    <div class="modal fade" id="templateModal" tabindex="-1" aria-labelledby="templateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="templateModalLabel">Plantilla de mail</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">
                            Puede usar:<br>
                            {Nombre} para nombre del paciente.<br>
                            {Apellido} para apellido del paciente.<br>
                            {Dia} para el dia del turno.<br>
                            {Hora} para la hora del turno.<br>
                            {Profesional} para el nombre del profesional.<br>
                            {Estado} para el estado del turno.
                        </label>
                        <textarea asp-for="Status.EmailTemplate" class="form-control" rows="10"></textarea>
                        <span asp-validation-for="Status.EmailTemplate" class="text-danger"></span>
                    </div>

                    <div class="text-muted small">
                        Ejemplo: Hola {Nombre}, su turno para {Dia} cambió a {Estado}
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Aceptar</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
