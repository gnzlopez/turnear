@page "/admin/appointment-statuses/create"
@model AppointmentManager.Pages.Admin.AppointmentStatuses.CreateModel

@{
    ViewData["Title"] = "Crear estado de turno";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h3 mb-1">Crear estado de turno</h1>
            <p class="text-muted mb-0">
                Cargá un nuevo estado para clasificar los turnos.
            </p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Status.Name" class="form-label">
                            Nombre
                        </label>

                        <input asp-for="Status.Name"
                               class="form-control"
                               placeholder="Ej: Pendiente, Confirmado, Cancelado" />

                        <span asp-validation-for="Status.Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check mt-3">
                            <input asp-for="Status.SendMail" class="form-check-input" />
                            <label class="form-check-label">Envia Mail</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}