@page "/admin/appointment-statuses/create"
@model AppointmentManager.Pages.Admin.AppointmentStatuses.CreateModel

@{
    ViewData["Title"] = "Crear estado de turno";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h3 mb-1">Crear estado de turno</h1>
            <p class="text-muted mb-0">
                Cargá un nuevo estado para clasificar los turnos.
            </p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Status.Name" class="form-label">
                            Nombre
                        </label>

                        <input asp-for="Status.Name"
                               class="form-control"
                               placeholder="Ej: Pendiente, Confirmado, Cancelado" />

                        <span asp-validation-for="Status.Name" class="text-danger"></span>
                    </div>

                    <div class="form-check mt-3">
                            <input asp-for="Status.SendMail" class="form-check-input" />
                            <label asp-for="Status.SendMail" class="form-check-label">Envia Mail</label>
                    </div>
                </div>

                <!-- Modal -->
                <div class="d-flex justify-content-start gap-2 mt-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#templateModal">
                        Plantilla de Mail
                    </button>
                </div>

                <!-- Acciones -->
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Guardar
                    </button>
                </div>

                <!-- Modal: editar plantilla (dentro del mismo form para que el textarea se posteé junto con Status) -->
                <div class="modal fade" id="templateModal" tabindex="-1" aria-labelledby="templateModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="templateModalLabel">Plantilla de mail</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                            </div>

                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">
                                        Puede usar:<br>
                                        {Nombre} para nombre del paciente.<br>
                                        {Apellido} para apellido del paciente.<br>
                                        {Dia} para el dia del turno.<br>
                                        {Hora} para la hora del turno.<br>
                                        {Profesional} para el nombre del profesional.<br>
                                        {Estado} para el estado del turno. </label>
                                    <textarea asp-for="Status.EmailTemplate" class="form-control" rows="10"></textarea>
                                    <span asp-validation-for="Status.EmailTemplate" class="text-danger"></span>
                                </div>

                                <div class="text-muted small">
                                    Ejemplo: Hola {Nombre}, su turno para {Dia} cambió a {Estado}
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Aceptar</button>
                            </div>
                        </div>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}