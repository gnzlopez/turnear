@page "/admin/appointment-statuses/details/{id:int}"
@model AppointmentManager.Pages.Admin.AppointmentStatuses.DetailsModel

@{
    ViewData["Title"] = "Detalle del estado";
    var appointmentStatus = Model.Status;
}

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h3 mb-1">Detalle del estado</h1>
            <p class="text-muted mb-0">
                Información del estado de turno seleccionado.
            </p>
        </div>

        <div class="col-auto">
            <a asp-page="./Edit"
               asp-route-id="@appointmentStatus.Id"
               class="btn btn-primary">
                Editar
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">
                    @appointmentStatus.Name
                </dd>
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-page="./Index" class="btn btn-outline-secondary">
            Volver
        </a>

        <a asp-page="./Delete"
           asp-route-id="@appointmentStatus.Id"
           class="btn btn-outline-danger">
            Eliminar
        </a>
    </div>
</div>