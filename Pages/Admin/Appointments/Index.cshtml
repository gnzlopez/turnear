@page "/admin/appointments"
@model AppointmentManager.Pages.Admin.Appointments.IndexModel

@{
    ViewData["Title"] = "Turnos";
}

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h3 mb-1">Turnos</h1>
            <p class="text-muted mb-0">
                Administrá los turnos creados para pacientes y profesionales.
            </p>
        </div>

        <div class="col-auto">
            <a asp-page="./Create" class="btn btn-primary">
                Crear turno
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (!Model.Appointments.Any())
            {
                <div class="alert alert-info mb-0">
                    Todavía no hay turnos cargados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Horario</th>
                                <th>Paciente</th>
                                <th>Profesional</th>
                                <th>Especialidad</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Appointments)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">
                                            @item.StartAt.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>

                                    <td>
                                        @item.StartAt.ToString("HH:mm") - @item.EndAt.ToString("HH:mm")
                                        <span class="text-muted small">
                                            (@item.DurationMinutes min)
                                        </span>
                                    </td>

                                    <td>
                                        @GetPatientName(item)
                                    </td>

                                    <td>
                                        @GetProfessionalName(item)
                                    </td>

                                    <td>
                                        @GetSpecialtyName(item)
                                    </td>

                                    <td>
                                        <span class="badge @GetStatusBadgeClass(item.Status?.Name)">
                                            @(item.Status?.Name ?? "Sin estado")
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-page="./Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-secondary">
                                                Ver
                                            </a>

                                            <a asp-page="./Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-primary">
                                                Editar
                                            </a>

                                            <a asp-page="./Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-danger">
                                                Cancelar
                                            </a>

                                            <!-- Botón para abrir el modal de cambio de estado -->
                                            <button type="button"
                                                    class="btn btn-outline-info"
                                                    onclick="openChangeStatusModal(@item.Id, @item.StatusId)">
                                                Cambiar estado
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal para cambiar estado -->
<div class="modal fade" id="changeStatusModal" tabindex="-1" aria-labelledby="changeStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="ChangeStatus">
                <div class="modal-header">
                    <h5 class="modal-title" id="changeStatusModalLabel">Cambiar estado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    @* Campo oculto con el id del turno *@
                    <input type="hidden" id="modalAppointmentId" name="appointmentId" />

                    <label class="form-label">Estado</label>
                    <select id="modalStatusId" name="statusId" class="form-select">
                        <option value="">Seleccione...</option>
                        @foreach (var s in Model.Statuses)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Aceptar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    private static string GetPatientName(AppointmentManager.Models.Appointment appointment)
    {
        if (appointment.Patient is null)
        {
            return "-";
        }

        return $"{appointment.Patient.LastName}, {appointment.Patient.FirstName}";
    }

    private static string GetProfessionalName(AppointmentManager.Models.Appointment appointment)
    {
        if (appointment.Professional is null)
        {
            return "-";
        }

        return $"{appointment.Professional.LastName}, {appointment.Professional.FirstName}";
    }

    private static string GetSpecialtyName(AppointmentManager.Models.Appointment appointment)
    {
        return appointment.Specialty?.Name
            ?? appointment.Professional?.Specialty?.Name
            ?? "-";
    }

    private static string GetStatusBadgeClass(string? statusName)
    {
        return statusName?.ToLowerInvariant() switch
        {
            "pending" => "text-bg-warning",
            "pendiente" => "text-bg-warning",

            "confirmed" => "text-bg-success",
            "confirmado" => "text-bg-success",

            "cancelled" => "text-bg-secondary",
            "canceled" => "text-bg-secondary",
            "cancelado" => "text-bg-secondary",

            "rejected" => "text-bg-danger",
            "rechazado" => "text-bg-danger",

            "noshow" => "text-bg-dark",
            "no show" => "text-bg-dark",
            "ausente" => "text-bg-dark",

            _ => "text-bg-light text-dark"
        };
    }
}

<script>
    // Abre el modal y setea los campos (usa Bootstrap 5)
    function openChangeStatusModal(appointmentId, currentStatusId) {
        document.getElementById('modalAppointmentId').value = appointmentId;
        var select = document.getElementById('modalStatusId');

        // Si currentStatusId es 0 o vacío, deseleccionar
        try {
            select.value = currentStatusId || "";
        } catch (e) {
            select.selectedIndex = 0;
        }

        var modalEl = document.getElementById('changeStatusModal');
        var modal = new bootstrap.Modal(modalEl);
        modal.show();
    }
</script>