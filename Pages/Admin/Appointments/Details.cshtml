@page "/admin/appointments/details/{id:int}"
@model AppointmentManager.Pages.Admin.Appointments.DetailsModel

@{
    ViewData["Title"] = "Detalle del turno";
    var appointment = Model.Appointment;
}

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h3 mb-1">Detalle del turno</h1>
            <p class="text-muted mb-0">
                Información completa del turno seleccionado.
            </p>
        </div>

        <div class="col-auto">
            <a asp-page="./Edit"
               asp-route-id="@appointment.Id"
               class="btn btn-primary">
                Editar
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Fecha</dt>
                <dd class="col-sm-9">
                    @appointment.StartAt.ToString("dd/MM/yyyy")
                </dd>

                <dt class="col-sm-3">Horario</dt>
                <dd class="col-sm-9">
                    @appointment.StartAt.ToString("HH:mm") - @appointment.EndAt.ToString("HH:mm")
                    <span class="text-muted small">
                        (@appointment.DurationMinutes min)
                    </span>
                </dd>

                <dt class="col-sm-3">Paciente</dt>
                <dd class="col-sm-9">
                    @(appointment.Patient is null ? "-" : $"{appointment.Patient.LastName}, {appointment.Patient.FirstName}")
                </dd>

                <dt class="col-sm-3">Profesional</dt>
                <dd class="col-sm-9">
                    @(appointment.Professional is null ? "-" : $"{appointment.Professional.LastName}, {appointment.Professional.FirstName}")
                </dd>

                <dt class="col-sm-3">Especialidad</dt>
                <dd class="col-sm-9">
                    @(appointment.Specialty?.Name ?? appointment.Professional?.Specialty?.Name ?? "-")
                </dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">
                    <span class="badge @GetStatusBadgeClass(appointment.Status?.Name)">
                        @(appointment.Status?.Name ?? "Sin estado")
                    </span>
                </dd>

                <dt class="col-sm-3">Notas</dt>
                <dd class="col-sm-9">
                    @if (string.IsNullOrWhiteSpace(appointment.Notes))
                    {
                        <span class="text-muted">Sin notas</span>
                    }
                    else
                    {
                        @appointment.Notes
                    }
                </dd>

                <dt class="col-sm-3">Creado</dt>
                <dd class="col-sm-9">
                    @appointment.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-page="./Index" class="btn btn-outline-secondary">
            Volver
        </a>

        <a asp-page="./Delete"
           asp-route-id="@appointment.Id"
           class="btn btn-outline-danger">
            Cancelar turno
        </a>
    </div>
</div>

@functions {
    private static string GetStatusBadgeClass(string? statusName)
    {
        return statusName?.ToLowerInvariant() switch
        {
            "pending" => "text-bg-warning",
            "pendiente" => "text-bg-warning",

            "confirmed" => "text-bg-success",
            "confirmado" => "text-bg-success",

            "cancelled" => "text-bg-secondary",
            "canceled" => "text-bg-secondary",
            "cancelado" => "text-bg-secondary",

            "rejected" => "text-bg-danger",
            "rechazado" => "text-bg-danger",

            "noshow" => "text-bg-dark",
            "no show" => "text-bg-dark",
            "ausente" => "text-bg-dark",

            _ => "text-bg-light text-dark"
        };
    }
}