@page "/admin/availability/details/{id:int}"
@model AppointmentManager.Pages.Admin.Availabilities.DetailsModel

@{
    ViewData["Title"] = "Detalle de disponibilidad";
    var availability = Model.ProfessionalAvailability;
}

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h3 mb-1">Detalle de disponibilidad</h1>
            <p class="text-muted mb-0">
                Información del rango horario cargado para el profesional.
            </p>
        </div>

        <div class="col-auto">
            <a asp-page="./Edit"
               asp-route-id="@availability.Id"
               class="btn btn-primary">
                Editar
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Profesional</dt>
                <dd class="col-sm-9">
                    @availability.Professional.LastName, @availability.Professional.FirstName
                </dd>

                <dt class="col-sm-3">Especialidad</dt>
                <dd class="col-sm-9">
                    @availability.Professional.Specialty.Name
                </dd>

                <dt class="col-sm-3">Día de la semana</dt>
                <dd class="col-sm-9">
                    @GetDayName(availability.DayOfWeek)
                </dd>

                <dt class="col-sm-3">Horario</dt>
                <dd class="col-sm-9">
                    @availability.StartTime.ToString("HH:mm") - @availability.EndTime.ToString("HH:mm")
                </dd>

                <dt class="col-sm-3">Duración del turno</dt>
                <dd class="col-sm-9">
                    @availability.SlotDurationMinutes minutos
                </dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">
                    @if (availability.IsActive)
                    {
                        <span class="badge text-bg-success">Activa</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Inactiva</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-page="./Index" class="btn btn-outline-secondary">
            Volver
        </a>

        <a asp-page="./Delete"
           asp-route-id="@availability.Id"
           class="btn btn-outline-danger">
            Eliminar
        </a>
    </div>
</div>

@functions {
    private static string GetDayName(DayOfWeek dayOfWeek)
    {
        return dayOfWeek switch
        {
            DayOfWeek.Monday => "Lunes",
            DayOfWeek.Tuesday => "Martes",
            DayOfWeek.Wednesday => "Miércoles",
            DayOfWeek.Thursday => "Jueves",
            DayOfWeek.Friday => "Viernes",
            DayOfWeek.Saturday => "Sábado",
            DayOfWeek.Sunday => "Domingo",
            _ => dayOfWeek.ToString()
        };
    }
}