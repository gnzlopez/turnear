@page "/admin/availability"
@model AppointmentManager.Pages.Admin.Availabilities.IndexModel

@{
    ViewData["Title"] = "Disponibilidad";
}

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h3 mb-1">Disponibilidad</h1>
            <p class="text-muted mb-0">
                Administrá los días y rangos horarios en los que atiende cada profesional.
            </p>
        </div>

        <div class="col-auto">
            <a asp-page="./Create" class="btn btn-primary">
                Crear disponibilidad
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (!Model.ProfessionalAvailability.Any())
            {
                <div class="alert alert-info mb-0">
                    Todavía no hay disponibilidades cargadas.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Profesional</th>
                                <th>Especialidad</th>
                                <th>Día</th>
                                <th>Horario</th>
                                <th>Duración</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ProfessionalAvailability)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">
                                            @item.Professional.LastName, @item.Professional.FirstName
                                        </span>
                                    </td>

                                    <td>
                                        @item.Professional.Specialty.Name
                                    </td>

                                    <td>
                                        @GetDayName(item.DayOfWeek)
                                    </td>

                                    <td>
                                        @item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")
                                    </td>

                                    <td>
                                        @item.SlotDurationMinutes min
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge text-bg-success">Activa</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">Inactiva</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-page="./Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-secondary">
                                                Ver
                                            </a>

                                            <a asp-page="./Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-primary">
                                                Editar
                                            </a>

                                            <a asp-page="./Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-danger">
                                                Eliminar
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    private static string GetDayName(DayOfWeek dayOfWeek)
    {
        return dayOfWeek switch
        {
            DayOfWeek.Monday => "Lunes",
            DayOfWeek.Tuesday => "Martes",
            DayOfWeek.Wednesday => "Miércoles",
            DayOfWeek.Thursday => "Jueves",
            DayOfWeek.Friday => "Viernes",
            DayOfWeek.Saturday => "Sábado",
            DayOfWeek.Sunday => "Domingo",
            _ => dayOfWeek.ToString()
        };
    }
}