@page "/admin/specialties/details/{id:int}"
@model AppointmentManager.Pages.Admin.Specialties.DetailsModel

@{
    ViewData["Title"] = "Detalle de especialidad";
    var specialty = Model.Specialty;
}

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h3 mb-1">Detalle de especialidad</h1>
            <p class="text-muted mb-0">
                Información registrada de la especialidad.
            </p>
        </div>

        <div class="col-auto">
            <a asp-page="./Edit"
               asp-route-id="@specialty.Id"
               class="btn btn-primary">
                Editar
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">
                    @specialty.Name
                </dd>

                <dt class="col-sm-3">Descripción</dt>
                <dd class="col-sm-9">
                    @if (string.IsNullOrWhiteSpace(specialty.Description))
                    {
                        <span class="text-muted">Sin descripción</span>
                    }
                    else
                    {
                        @specialty.Description
                    }
                </dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">
                    @if (specialty.IsActive)
                    {
                        <span class="badge text-bg-success">Activa</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Inactiva</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-page="./Index" class="btn btn-outline-secondary">
            Volver
        </a>

        <a asp-page="./Delete"
           asp-route-id="@specialty.Id"
           class="btn btn-outline-danger">
            Eliminar
        </a>
    </div>
</div>