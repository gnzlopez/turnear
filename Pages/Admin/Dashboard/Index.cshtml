@page "/admin"
@model AppointmentManager.Pages.Admin.Dashboard.IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h3 mb-1">Dashboard</h1>
            <p class="text-muted mb-0">
                Resumen general del sistema de turnos.
            </p>
        </div>

        <div class="col-auto">
            <a asp-page="/Admin/Appointments/Create" class="btn btn-primary">
                Crear turno
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="dashboard-card p-4 h-100">
                <p class="dashboard-card-label mb-1">Turnos de hoy</p>
                <h2 class="dashboard-card-value mb-0">@Model.TodayAppointmentsCount</h2>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="dashboard-card p-4 h-100">
                <p class="dashboard-card-label mb-1">Próximos 7 días</p>
                <h2 class="dashboard-card-value mb-0">@Model.NextSevenDaysAppointmentsCount</h2>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="dashboard-card p-4 h-100">
                <p class="dashboard-card-label mb-1">Turnos pendientes</p>
                <h2 class="dashboard-card-value mb-0">@Model.PendingAppointmentsCount</h2>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="dashboard-card p-4 h-100">
                <p class="dashboard-card-label mb-1">Disponibilidades activas</p>
                <h2 class="dashboard-card-value mb-0">@Model.ActiveAvailabilitiesCount</h2>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                        <div>
                            <h2 class="h5 mb-1">Próximos turnos</h2>
                            <p class="text-muted mb-0">
                                Turnos más cercanos registrados en el sistema.
                            </p>
                        </div>

                        <a asp-page="/Admin/Appointments/Index" class="btn btn-sm btn-outline-primary">
                            Ver todos
                        </a>
                    </div>

                    @if (!Model.UpcomingAppointments.Any())
                    {
                        <div class="alert alert-info mb-0">
                            No hay próximos turnos registrados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Horario</th>
                                        <th>Paciente</th>
                                        <th>Profesional</th>
                                        <th>Estado</th>
                                        <th class="text-end">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.UpcomingAppointments)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-semibold">
                                                    @item.StartAt.ToString("dd/MM/yyyy")
                                                </span>
                                            </td>

                                            <td>
                                                @item.StartAt.ToString("HH:mm") - @item.EndAt.ToString("HH:mm")
                                            </td>

                                            <td>
                                                @(item.Patient is null ? "-" : $"{item.Patient.LastName}, {item.Patient.FirstName}")
                                            </td>

                                            <td>
                                                @(item.Professional is null ? "-" : $"{item.Professional.LastName}, {item.Professional.FirstName}")
                                            </td>

                                            <td>
                                                <span class="badge @GetStatusBadgeClass(item.Status?.Name)">
                                                    @(item.Status?.Name ?? "Sin estado")
                                                </span>
                                            </td>

                                            <td class="text-end">
                                                <a asp-page="/Admin/Appointments/Details"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-secondary">
                                                    Ver
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Resumen</h2>

                    <div class="d-flex justify-content-between border-bottom py-2">
                        <span class="text-muted">Pacientes</span>
                        <span class="fw-semibold">@Model.PatientsCount</span>
                    </div>

                    <div class="d-flex justify-content-between border-bottom py-2">
                        <span class="text-muted">Profesionales</span>
                        <span class="fw-semibold">@Model.ProfessionalsCount</span>
                    </div>

                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Disponibilidades activas</span>
                        <span class="fw-semibold">@Model.ActiveAvailabilitiesCount</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h2 class="h5 mb-3">Acciones rápidas</h2>

                    <div class="d-grid gap-2">
                        <a asp-page="/Admin/Appointments/Create" class="btn btn-primary">
                            Crear turno
                        </a>

                        <a asp-page="/Admin/Patients/Create" class="btn btn-outline-primary">
                            Crear paciente
                        </a>

                        <a asp-page="/Admin/Professionals/Create" class="btn btn-outline-primary">
                            Crear profesional
                        </a>

                        <a asp-page="/Admin/Availability/Create" class="btn btn-outline-primary">
                            Cargar disponibilidad
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private static string GetStatusBadgeClass(string? statusName)
    {
        return statusName?.ToLowerInvariant() switch
        {
            "pending" => "text-bg-warning",
            "pendiente" => "text-bg-warning",

            "confirmed" => "text-bg-success",
            "confirmado" => "text-bg-success",

            "cancelled" => "text-bg-secondary",
            "canceled" => "text-bg-secondary",
            "cancelado" => "text-bg-secondary",

            "rejected" => "text-bg-danger",
            "rechazado" => "text-bg-danger",

            "noshow" => "text-bg-dark",
            "no show" => "text-bg-dark",
            "ausente" => "text-bg-dark",

            _ => "text-bg-light text-dark"
        };
    }
}