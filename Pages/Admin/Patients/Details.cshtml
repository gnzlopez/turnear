@page "/admin/patients/details/{id:int}"
@model AppointmentManager.Pages.Admin.Patients.DetailsModel

@{
    ViewData["Title"] = "Detalle del paciente";
    var patient = Model.Patient;
}

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h3 mb-1">Detalle del paciente</h1>
            <p class="text-muted mb-0">
                Información registrada del paciente.
            </p>
        </div>

        <div class="col-auto">
            <a asp-page="./Edit"
               asp-route-id="@patient.Id"
               class="btn btn-primary">
                Editar
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">
                    @patient.FirstName
                </dd>

                <dt class="col-sm-3">Apellido</dt>
                <dd class="col-sm-9">
                    @patient.LastName
                </dd>

                <dt class="col-sm-3">Nombre completo</dt>
                <dd class="col-sm-9">
                    @patient.FullName
                </dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">
                    @if (string.IsNullOrWhiteSpace(patient.Email))
                    {
                        <span class="text-muted">Sin email</span>
                    }
                    else
                    {
                        @patient.Email
                    }
                </dd>

                <dt class="col-sm-3">Teléfono</dt>
                <dd class="col-sm-9">
                    @if (string.IsNullOrWhiteSpace(patient.Phone))
                    {
                        <span class="text-muted">Sin teléfono</span>
                    }
                    else
                    {
                        @patient.Phone
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-page="./Index" class="btn btn-outline-secondary">
            Volver
        </a>

        <a asp-page="./Delete"
           asp-route-id="@patient.Id"
           class="btn btn-outline-danger">
            Eliminar
        </a>
    </div>
</div>