@page "/reservar-turno"
@model AppointmentManager.Pages.Public.Booking.IndexModel

@{
    ViewData["Title"] = "Reservar turno";
}

<section class="public-section">
    <div class="container">
        <div class="row mb-4 align-items-center">
            <div class="col-lg-8">
                <h1 class="h2 fw-bold mb-2">Reservar turno</h1>
                <p class="text-muted mb-0">
                    Seleccioná un profesional, elegí un horario disponible y completá tus datos.
                </p>
            </div>
        </div>

        <div class="public-card p-4 mb-4">
            <form method="post" asp-page-handler="SearchSlots">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label asp-for="Input.ProfessionalId" class="form-label">
                            Profesional
                        </label>

                        <select asp-for="Input.ProfessionalId"
                                asp-items="Model.ProfessionalSelect"
                                class="form-select">
                            <option value="">Seleccionar profesional</option>
                        </select>

                        <span asp-validation-for="Input.ProfessionalId" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Input.Date" class="form-label">
                            Fecha
                        </label>

                        <input asp-for="Input.Date"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Input.Date" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            Buscar horarios
                        </button>
                    </div>
                </div>
            </form>
        </div>

        @if (Model.SearchWasPerformed)
        {
            <div class="public-card p-4">
                @if (!Model.AvailableSlots.Any())
                {
                    <h2 class="h5 mb-3">Horarios disponibles</h2>

                    <div class="alert alert-warning mb-0">
                        No hay horarios disponibles para el profesional y la fecha seleccionados.
                    </div>
                }
                else
                {
                    <form method="post" asp-page-handler="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Input.ProfessionalId" />
                        <input type="hidden" asp-for="Input.Date" />

                        <div class="mb-4">
                            <h2 class="h5 mb-3">Horarios disponibles</h2>

                            <div class="booking-slots-grid">
                                @for (var i = 0; i < Model.AvailableSlots.Count; i++)
                                {
                                    var slot = Model.AvailableSlots[i];
                                    var slotValue = $"{slot.StartAt:O}|{slot.EndAt:O}";
                                    var slotId = $"slot_{i}";

                                    <input type="radio"
                                           class="btn-check"
                                           asp-for="Input.SelectedSlotValue"
                                           id="@slotId"
                                           value="@slotValue"
                                           autocomplete="off" />

                                    <label class="btn btn-outline-primary booking-slot-button" for="@slotId">
                                        <span class="fw-semibold">@slot.StartAt.ToString("HH:mm")</span>
                                        <small class="d-block">
                                            hasta @slot.EndAt.ToString("HH:mm")
                                        </small>
                                    </label>
                                }
                            </div>

                            <span asp-validation-for="Input.SelectedSlotValue" class="text-danger"></span>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-3">
                            <h2 class="h5 mb-1">Tus datos</h2>
                            <p class="text-muted mb-0">
                                Usaremos estos datos para registrar la solicitud del turno.
                            </p>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.PatientFirstName" class="form-label">
                                    Nombre
                                </label>

                                <input asp-for="Input.PatientFirstName"
                                       class="form-control"
                                       placeholder="Ej: Juan" />

                                <span asp-validation-for="Input.PatientFirstName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.PatientLastName" class="form-label">
                                    Apellido
                                </label>

                                <input asp-for="Input.PatientLastName"
                                       class="form-control"
                                       placeholder="Ej: Pérez" />

                                <span asp-validation-for="Input.PatientLastName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.Phone" class="form-label">
                                    Teléfono
                                </label>

                                <input asp-for="Input.Phone"
                                       class="form-control"
                                       placeholder="Ej: +54 9 341 0000000" />

                                <span asp-validation-for="Input.Phone" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.Email" class="form-label">
                                    Email
                                </label>

                                <input asp-for="Input.Email"
                                       class="form-control"
                                       placeholder="Opcional" />

                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Input.Notes" class="form-label">
                                    Comentarios
                                </label>

                                <textarea asp-for="Input.Notes"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Opcional"></textarea>

                                <span asp-validation-for="Input.Notes" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                            <a asp-page="/Public/Home/Index" class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Solicitar turno
                            </button>
                        </div>
                    </form>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}