@{
    var title = ViewData["Title"] as string ?? "Backoffice";
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@title - AppointmentManager</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar admin-mobile-navbar d-lg-none">
        <div class="container-fluid">
            <button class="btn btn-outline-light"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#adminMenu"
                    aria-controls="adminMenu">
                Menú
            </button>

            <a class="navbar-brand ms-2" asp-page="/Admin/Dashboard/Index">
                AppointmentManager
            </a>
        </div>
    </nav>

    <div class="offcanvas offcanvas-start admin-offcanvas d-lg-none"
         tabindex="-1"
         id="adminMenu"
         aria-labelledby="adminMenuLabel">

        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="adminMenuLabel">Backoffice</h5>

            <button type="button"
                    class="btn-close btn-close-white"
                    data-bs-dismiss="offcanvas"
                    aria-label="Cerrar"></button>
        </div>

        <div class="offcanvas-body">
            <nav class="d-flex flex-column gap-1">
                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/Dashboard"))"
                   asp-page="/Admin/Dashboard/Index">
                    Dashboard
                </a>

                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/Appointments"))"
                   asp-page="/Admin/Appointments/Index">
                    Turnos
                </a>

                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/Patients"))"
                   asp-page="/Admin/Patients/Index">
                    Pacientes
                </a>

                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/Professionals"))"
                   asp-page="/Admin/Professionals/Index">
                    Profesionales
                </a>

                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/Specialties"))"
                   asp-page="/Admin/Specialties/Index">
                    Especialidades
                </a>

                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/Availabilities"))"
                   asp-page="/Admin/Availabilities/Index">
                    Disponibilidad
                </a>

                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/AppointmentStatuses"))"
                   asp-page="/Admin/AppointmentStatuses/Index">
                    Estados de turnos
                </a>

                <hr class="border-secondary my-3" />

                <a class="admin-nav-link"
                   asp-page="/Public/Home/Index">
                    Ver sitio público
                </a>
            </nav>
        </div>
    </div>

    <div class="d-flex">
        <aside class="admin-sidebar d-none d-lg-flex flex-column p-3">
            <div class="mb-4">
                <a class="admin-brand" asp-page="/Admin/Appointments/Index">
                    AppointmentManager
                </a>

                <div class="text-secondary small mt-1">
                    Backoffice
                </div>
            </div>

            <nav class="d-flex flex-column gap-1">
                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/Dashboard"))"
                   asp-page="/Admin/Dashboard/Index">
                    Dashboard
                </a>

                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/Appointments"))"
                   asp-page="/Admin/Appointments/Index">
                    Turnos
                </a>

                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/Patients"))"
                   asp-page="/Admin/Patients/Index">
                    Pacientes
                </a>

                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/Professionals"))"
                   asp-page="/Admin/Professionals/Index">
                    Profesionales
                </a>

                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/Specialties"))"
                   asp-page="/Admin/Specialties/Index">
                    Especialidades
                </a>

                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/Availabilities"))"
                   asp-page="/Admin/Availabilities/Index">
                    Disponibilidad
                </a>

                <a class="admin-nav-link @(IsActive(currentPage, "/Admin/AppointmentStatuses"))"
                   asp-page="/Admin/AppointmentStatuses/Index">
                    Estados de turnos
                </a>
            </nav>

            <hr class="border-secondary my-4" />

            <nav class="d-flex flex-column gap-1">
                <a class="admin-nav-link"
                   asp-page="/Public/Home/Index">
                    Ver sitio público
                </a>
            </nav>
        </aside>

        <div class="admin-content flex-grow-1 d-flex flex-column">
            <header class="admin-topbar border-bottom">
                <div class="container-fluid py-3">
                    <div class="d-flex justify-content-between align-items-center gap-3">
                        <div>
                            <span class="fw-semibold">@title</span>
                        </div>

                        <div>
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </div>
            </header>

            <main class="admin-main flex-grow-1">
                @RenderBody()
            </main>

            <footer class="border-top bg-white mt-auto">
                <div class="container-fluid py-3">
                    <span class="text-muted small">
                        &copy; @DateTime.Now.Year - AppointmentManager
                    </span>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private static string IsActive(string currentPage, string section)
    {
        return currentPage.StartsWith(section, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    }
}