@{
    var title = ViewData["Title"] as string ?? "TurneAr";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@title - TurneAr</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-white">
    <header class="public-header border-bottom">
        <nav class="navbar navbar-expand-lg navbar-light bg-white">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Public/Home/Index">
                    TurneAr
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNavbar"
                        aria-controls="publicNavbar" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="publicNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Public/Home/Index">Inicio</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Public/Specialties/Index">Especialidades</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Public/Professionals/Index">Profesionales</a>
                        </li>

                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-primary px-4" asp-page="/Public/Booking/Index">
                                Reservar turno
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1 bg-white">
        @RenderBody()
    </main>

    <footer class="public-footer border-top mt-auto">
        <div class="container py-4">
            <div class="row align-items-center gy-3">
                <div class="col-md-6">
                    <p class="mb-1 fw-semibold">TurneAr</p>
                    <p class="mb-0 text-muted small">
                        Sistema de turnos para profesionales y centros de atención.
                    </p>
                </div>

                <div class="col-md-6 text-md-end">
                    <a class="text-muted small text-decoration-none" asp-page="/Account/Login" asp-area="Identity">
                        Acceso interno
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>